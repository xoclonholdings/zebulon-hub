# Zebulon AI System - Environment Configuration Template
# Copy this file to .env and update with your values

NODE_ENV=development
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
SESSION_SECRET=your-random-secret-key-here-min-32-chars-recommended-64
PORT=5000

# Optional: OpenAI API for enhanced AI features (not required for core functionality)
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom host binding (defaults to 0.0.0.0 in production)
# HOST=127.0.0.1

# Production deployment notes:
# - Use a strong, unique SESSION_SECRET (64+ characters recommended)
# - Ensure DATABASE_URL points to your PostgreSQL instance
# - Set NODE_ENV=production for production deployments