# Zebulon AI System - Environment Configuration
NODE_ENV=development
DATABASE_URL=postgresql://username:password@localhost:5432/zebulon
SESSION_SECRET=your-random-secret-key-here-min-32-chars
PORT=5000

# Optional: OpenAI API for enhanced AI features (not required for core functionality)
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom host binding
# HOST=127.0.0.1