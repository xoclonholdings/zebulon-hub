# Zebulon Oracle System - Environment Configuration

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/zebulon_oracle"

# Security
SESSION_SECRET="your-super-secure-random-string-change-this-in-production"

# Server Configuration
NODE_ENV="production"
PORT=5000

# ZCOS / ZAR gateway
VITE_ZAR_APP_URL="https://your-zar-origin.example"

# Optional: Custom Domain
DOMAIN="xoclon.online"
