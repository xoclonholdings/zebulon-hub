{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist/server",
    "rootDir": "./server",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"],
      "@server/*": ["./server/*"]
    },
    "types": ["node"],
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "server/index.ts",
    "server/storage-clean.ts",
    "server/init-db.ts",
    "server/db.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "client",
    "server/services",
    "server/routes",
    "server/security",
    "server/middleware",
    "server/public",
    "server/routes.ts",
    "server/storage.ts",
    "server/vite.ts",
    "server/storage-prisma.ts",
    "server/index-clean.ts"
  ]
}