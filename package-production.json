{
  "name": "zebulon-ai-production",
  "version": "1.0.0",
  "description": "Zebulon AI Oracle System - Production Build",
  "main": "dist/index.js",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "start:cluster": "NODE_ENV=production node dist/start-optimized.js",
    "db:migrate": "npm run db:push",
    "health": "curl -f http://localhost:${PORT:-3000}/api/health",
    "security:scan": "curl -X POST http://localhost:${PORT:-3000}/api/security/scan -H 'Content-Type: application/json' -d '{}'",
    "logs": "journalctl -u zebulon-ai -f"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "express-session": "^1.18.0",
    "helmet": "^7.0.0",
    "drizzle-orm": "^0.35.0",
    "@neondatabase/serverless": "^0.10.0",
    "bcrypt": "^5.1.0",
    "zod": "^3.22.0",
    "nanoid": "^5.0.0",
    "sanitize-html": "^2.11.0",
    "validator": "^13.11.0",
    "ws": "^8.14.0"
  },
  "keywords": [
    "ai",
    "oracle",
    "database",
    "security",
    "zebulon"
  ],
  "license": "MIT"
}