{
  "name": "zebulon-desktop",
  "version": "1.0.0",
  "description": "Zebulon AI Desktop Application",
  "main": "main.js",
  "type": "commonjs",
  "dependencies": {
    "electron": "^33.2.1"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "start": "electron main.js",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "build": {
    "appId": "com.zebulon.ai",
    "productName": "Zebulon AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "../dist/**/*",
      "../package.json"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "dist/**/*",
          "package.json",
          "node_modules/**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}