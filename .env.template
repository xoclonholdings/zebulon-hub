# Zebulon Oracle System Environment Configuration

# Primary Database (Online/Cloud)
DATABASE_URL="postgresql://username:password@host:port/database"

# Secondary Database (Local/Offline) - Optional
DATABASE_URL_LOCAL="postgresql://username:password@localhost:5432/zebulon_local"

# Neon Database (Cloud) - Optional  
DATABASE_URL_NEON="postgresql://username:password@neon-host:port/database"

# Server Configuration
NODE_ENV="production"
PORT=5000

# Session Secret (Generate a secure random string)
SESSION_SECRET="your-secure-session-secret-here"

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_PATH="./uploads"

# PostgreSQL Connection Details (Auto-populated by Replit)
PGHOST="localhost"
PGPORT="5432"
PGUSER="username"
PGPASSWORD="password"
PGDATABASE="database_name"

# Security Configuration
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Application Configuration
LOG_LEVEL="info"
CORS_ORIGIN="*"
TRUST_PROXY=false