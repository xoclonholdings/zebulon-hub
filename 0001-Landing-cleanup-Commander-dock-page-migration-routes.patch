diff --git a/client/src/system/commanderDock.ts b/client/src/system/commanderDock.ts
new file mode 100644
index 0000000..a37a221
--- /dev/null
+++ b/client/src/system/commanderDock.ts
@@ -0,0 +1,93 @@
+import {
+  BookOpen,
+  Database,
+  FolderOpen,
+  History,
+  MessageSquare,
+  ShieldCheck,
+  Upload,
+  type LucideIcon,
+} from "lucide-react";
+
+import { GALAXY_CONTRACTS, type GalaxyId } from "@/galaxies/registry";
+
+/**
+ * Config-driven Commander dock manifest — mirrors the per-galaxy NEXYS dock
+ * pattern. A destination is only presented as operational when it has a real
+ * `route`. `route: null` renders a truthful "forming" state (no fake data).
+ */
+export interface DockDestination {
+  readonly id: string;
+  readonly label: string;
+  readonly Icon: LucideIcon;
+  readonly route: string | null;
+  /** Sub-surfaces that branch out of a universal control (Image / Doc / Talk). */
+  readonly branch?: readonly DockDestination[];
+}
+
+export interface CommanderDockManifest {
+  /** Exactly five primary buttons: Chat · Upload universal, then three Desk controls. */
+  readonly tabs: readonly [DockDestination, DockDestination, DockDestination, DockDestination, DockDestination];
+  /** Universal Console options outside the five-button count. */
+  readonly buttons: readonly DockDestination[];
+}
+
+// ZAR is the Commander identity — Chat/Upload open the ZAR console context.
+const ZAR_CONSOLE_ROUTE = "/zar";
+
+export const COMMANDER_DOCK: CommanderDockManifest = {
+  tabs: [
+    {
+      id: "chat",
+      label: "Chat",
+      Icon: MessageSquare,
+      route: ZAR_CONSOLE_ROUTE,
+      branch: [{ id: "chat-talk", label: "Talk", Icon: MessageSquare, route: ZAR_CONSOLE_ROUTE }],
+    },
+    {
+      id: "upload",
+      label: "Upload",
+      Icon: Upload,
+      route: ZAR_CONSOLE_ROUTE,
+      branch: [
+        { id: "upload-image", label: "Image", Icon: Upload, route: ZAR_CONSOLE_ROUTE },
+        { id: "upload-doc", label: "Document", Icon: Upload, route: ZAR_CONSOLE_ROUTE },
+        { id: "upload-talk", label: "Talk", Icon: MessageSquare, route: ZAR_CONSOLE_ROUTE },
+      ],
+    },
+    { id: "memory", label: "Memory", Icon: Database, route: "/memory" },
+    { id: "knowledge", label: "Knowledge", Icon: BookOpen, route: "/knowledge" },
+    { id: "projects", label: "Projects", Icon: FolderOpen, route: "/projects" },
+  ],
+  buttons: [
+    { id: "history", label: "History", Icon: History, route: "/history" },
+    { id: "admin", label: "Admin", Icon: ShieldCheck, route: "/admin" },
+  ],
+};
+
+/**
+ * Per-console Desk-control registry for all eight galaxies. Buttons three
+ * through five of every galaxy Dock are that galaxy's specialized Desk
+ * controls, sourced from the locked galaxy contracts.
+ */
+export interface ConsoleDeskEntry {
+  readonly id: GalaxyId;
+  readonly name: string;
+  readonly console: string;
+  readonly desk: string;
+  readonly controls: readonly [string, string, string];
+}
+
+export const CONSOLE_DESK_REGISTRY: readonly ConsoleDeskEntry[] = (
+  Object.keys(GALAXY_CONTRACTS) as GalaxyId[]
+).map((id) => {
+  const contract = GALAXY_CONTRACTS[id];
+  const [, , first, second, third] = contract.dock;
+  return {
+    id,
+    name: contract.name,
+    console: contract.console,
+    desk: contract.desk,
+    controls: [first, second, third] as const,
+  };
+});
