+import type { ReactNode } from "react";
+import { ArrowLeft } from "lucide-react";
+import { useLocation } from "wouter";
+
+export function CommanderPageShell({
+  eyebrow = "ZCOS Commander",
+  title,
+  subtitle,
+  backTo = "/",
+  backLabel = "Constellation",
+  testId,
+  children,
+}: {
+  readonly eyebrow?: string;
+  readonly title: string;
+  readonly subtitle: string;
+  readonly backTo?: string;
+  readonly backLabel?: string;
+  readonly testId?: string;
+  readonly children: ReactNode;
+}) {
+  const [, navigate] = useLocation();
+  return (
+    <main
+      data-testid={testId}
+      className="min-h-[100dvh] overflow-y-auto bg-[radial-gradient(circle_at_50%_15%,#121225_0%,#05050b_46%,#010103_100%)] px-4 pb-16 pt-5 text-white"
+    >
+      <div className="mx-auto w-full max-w-3xl">
+        <button
+          type="button"
+          data-testid="commander-page-back"
+          onClick={() => navigate(backTo)}
+          className="mb-5 inline-flex min-h-[44px] items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 text-sm text-white/70 transition-colors hover:text-white"
+        >
+          <ArrowLeft size={16} /> {backLabel}
+        </button>
+        <header className="rounded-[2rem] border border-white/10 bg-black/35 p-6 backdrop-blur-xl">
+          <p className="text-xs uppercase tracking-[0.28em] text-white/40">{eyebrow}</p>
+          <h1 className="mt-2 text-3xl font-semibold">{title}</h1>
+          <p className="mt-3 text-sm leading-6 text-white/50">{subtitle}</p>
+        </header>
+        <section className="mt-5">{children}</section>
+      </div>
+    </main>
+  );
+}
