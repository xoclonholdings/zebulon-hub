@@ -0,0 +1,66 @@
+import { useEffect, useState } from "react";
+
+import { apiRequest } from "@/lib/queryClient";
+import { CommanderPageShell } from "./CommanderPageShell";
+
+interface AuditEvent {
+  readonly id: string;
+  readonly eventType?: string;
+  readonly galaxyId?: string | null;
+  readonly createdAt?: string;
+}
+
+export default function HistoryPage() {
+  const [events, setEvents] = useState<AuditEvent[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    let active = true;
+    setLoading(true);
+    setError("");
+    void apiRequest("/api/zcos/admin/audit?limit=50")
+      .then((result) => {
+        if (!active) return;
+        setEvents(Array.isArray(result.events) ? result.events : []);
+      })
+      .catch((cause) => {
+        if (!active) return;
+        setError(cause instanceof Error ? cause.message : "Unable to load History.");
+      })
+      .finally(() => active && setLoading(false));
+    return () => {
+      active = false;
+    };
+  }, []);
+
+  return (
+    <CommanderPageShell
+      testId="history-page"
+      title="History"
+      subtitle="Commander-scoped activity — recent authorized events across ZCOS."
+    >
+      {loading ? (
+        <p data-testid="history-loading" className="text-sm text-white/40">Loading history…</p>
+      ) : error ? (
+        <p data-testid="history-error" className="rounded-xl border border-red-400/20 bg-red-500/10 p-3 text-sm text-red-200">{error}</p>
+      ) : events.length === 0 ? (
+        <p data-testid="history-empty" className="rounded-2xl border border-white/10 bg-white/[0.03] p-5 text-sm text-white/45">
+          No activity has been recorded yet.
+        </p>
+      ) : (
+        <div data-testid="history-list" className="space-y-2">
+          {events.map((event) => (
+            <article key={event.id} className="rounded-2xl border border-white/10 bg-white/[0.03] p-3">
+              <p className="text-sm text-white/65">{event.eventType || "event"}</p>
+              <p className="mt-1 text-xs text-white/30">
+                {event.galaxyId || "ZCOS"}
+                {event.createdAt ? ` · ${new Date(event.createdAt).toLocaleString()}` : ""}
+              </p>
+            </article>
+          ))}
+        </div>
+      )}
+    </CommanderPageShell>
+  );
+}
