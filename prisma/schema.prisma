generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ZcosGalaxy {
  id        String   @id
  console   String
  desk      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("zcos_galaxies")
}

model MemorySetting {
  ownerUserId   String   @id @map("owner_user_id")
  memoryEnabled Boolean  @default(true) @map("memory_enabled")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("zcos_memory_settings")
}

model MemoryRecord {
  id                 String    @id @default(cuid())
  ownerUserId        String    @map("owner_user_id")
  galaxyId           String    @map("galaxy_id")
  memoryType         String    @map("memory_type")
  canonicalName      String    @map("canonical_name")
  content            String
  properties         Json?
  topics             String[]  @default([])
  entityIds          String[]  @default([]) @map("entity_ids")
  sourceRefs         String[]  @default([]) @map("source_refs")
  confidence         Float?
  occurredAt         DateTime? @map("occurred_at")
  lifecycleState     String    @default("proposed") @map("lifecycle_state")
  confirmationMethod String?   @map("confirmation_method")
  supersedesId       String?   @map("supersedes_id")
  derivedFromIds     String[]  @default([]) @map("derived_from_ids")
  retentionPolicy    Json?     @map("retention_policy")
  deletedAt          DateTime? @map("deleted_at")
  deletionCascadeId  String?   @map("deletion_cascade_id")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, galaxyId, lifecycleState])
  @@index([ownerUserId, canonicalName])
  @@map("zcos_memory_records")
}

model MemoryRelationship {
  id             String   @id @default(cuid())
  ownerUserId    String   @map("owner_user_id")
  galaxyId       String   @map("galaxy_id")
  subjectId      String   @map("subject_id")
  objectId       String   @map("object_id")
  predicate      String
  sourceRefs     String[] @default([]) @map("source_refs")
  confidence     Float?
  lifecycleState String   @default("active") @map("lifecycle_state")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, galaxyId, subjectId])
  @@index([ownerUserId, galaxyId, objectId])
  @@map("zcos_memory_relationships")
}

model KnowledgeRecord {
  id             String    @id @default(cuid())
  ownerUserId    String    @map("owner_user_id")
  galaxyId       String    @map("galaxy_id")
  objectType     String    @map("object_type")
  canonicalName  String    @map("canonical_name")
  summary        String?
  properties     Json?
  topicIds       String[]  @default([]) @map("topic_ids")
  entityIds      String[]  @default([]) @map("entity_ids")
  sourceBindings String[]  @default([]) @map("source_bindings")
  originClass    String    @map("origin_class")
  scope          Json?
  lifecycleState String    @default("candidate") @map("lifecycle_state")
  confidence     Float?
  currency       String    @default("unknown")
  reviewedAt     DateTime? @map("reviewed_at")
  supersedesId   String?   @map("supersedes_id")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, galaxyId, lifecycleState])
  @@index([ownerUserId, canonicalName])
  @@map("zcos_knowledge_records")
}

model KnowledgeRelationship {
  id             String    @id @default(cuid())
  ownerUserId    String    @map("owner_user_id")
  galaxyId       String    @map("galaxy_id")
  subjectId      String    @map("subject_id")
  objectId       String    @map("object_id")
  predicate      String
  scope          Json?
  sourceBindings String[]  @default([]) @map("source_bindings")
  confidence     Float?
  lifecycleState String    @default("candidate") @map("lifecycle_state")
  validFrom      DateTime? @map("valid_from")
  validTo        DateTime? @map("valid_to")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, galaxyId, subjectId])
  @@index([ownerUserId, galaxyId, objectId])
  @@map("zcos_knowledge_relationships")
}

model TopicRecord {
  id             String   @id @default(cuid())
  ownerUserId    String   @map("owner_user_id")
  galaxyId       String   @map("galaxy_id")
  canonicalLabel String   @map("canonical_label")
  aliases        String[] @default([])
  description    String?
  parentIds      String[] @default([]) @map("parent_ids")
  relatedIds     String[] @default([]) @map("related_ids")
  lifecycleState String   @default("active") @map("lifecycle_state")
  redirectToId   String?  @map("redirect_to_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, galaxyId, lifecycleState])
  @@map("zcos_topics")
}

model LexiconSense {
  id             String   @id @default(cuid())
  ownerUserId    String   @map("owner_user_id")
  galaxyId       String   @map("galaxy_id")
  canonicalForm  String   @map("canonical_form")
  variants       String[] @default([])
  definition     String
  contexts       String[] @default([])
  domains        String[] @default([])
  communities    String[] @default([])
  examples       String[] @default([])
  sourceBindings String[] @default([]) @map("source_bindings")
  confidence     Float?
  lifecycleState String   @default("candidate") @map("lifecycle_state")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, galaxyId, canonicalForm])
  @@map("zcos_lexicon_senses")
}

model SourceRecord {
  id                String    @id @default(cuid())
  ownerUserId       String    @map("owner_user_id")
  galaxyId          String    @map("galaxy_id")
  sourceType        String    @map("source_type")
  sourceId          String    @map("source_id")
  sourceOwnerUserId String?   @map("source_owner_user_id")
  sourceGalaxyId    String?   @map("source_galaxy_id")
  originClass       String?   @map("origin_class")
  artifactRef       String?   @map("artifact_ref")
  title             String?
  author            String?
  publisher         String?
  locator           String?
  evidenceExcerpt   String?   @map("evidence_excerpt")
  extractionMethod  String?   @map("extraction_method")
  contentHash       String?   @map("content_hash")
  rights            Json?
  retention         Json?
  lineage           Json?
  metadata          Json?
  occurredAt        DateTime? @map("occurred_at")
  publishedAt       DateTime? @map("published_at")
  accessedAt        DateTime? @map("accessed_at")
  capturedAt        DateTime  @default(now()) @map("captured_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([ownerUserId, galaxyId])
  @@index([sourceType, sourceId])
  @@map("zcos_source_records")
}

model FileArtifact {
  id                   String   @id @default(cuid())
  ownerUserId          String   @map("owner_user_id")
  galaxyId             String   @default("zenith") @map("galaxy_id")
  uploadedFromGalaxyId String?  @map("uploaded_from_galaxy_id")
  category             String
  originalName         String   @map("original_name")
  mimeType             String   @map("mime_type")
  byteSize             Int      @map("byte_size")
  contentHash          String   @map("content_hash")
  content              Bytes
  version              Int      @default(1)
  status               String   @default("stored")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, contentHash])
  @@map("zcos_file_artifacts")
}

model PartitionGrant {
  id             String    @id @default(cuid())
  ownerUserId    String    @map("owner_user_id")
  sourceGalaxyId String    @map("source_galaxy_id")
  targetGalaxyId String    @map("target_galaxy_id")
  authorityKind  String    @map("authority_kind")
  permissions    String[]  @default([])
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  @@index([ownerUserId, sourceGalaxyId, targetGalaxyId])
  @@map("zcos_partition_grants")
}

model AuditEvent {
  id          String   @id @default(cuid())
  ownerUserId String?  @map("owner_user_id")
  galaxyId    String?  @map("galaxy_id")
  eventType   String   @map("event_type")
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ownerUserId, createdAt])
  @@map("zcos_audit_events")
}

model SocialConnection {
  id             String    @id @default(cuid())
  ownerUserId    String    @map("owner_user_id")
  provider       String
  accountRef     String    @map("account_ref")
  credentialRef  String?   @map("credential_ref")
  scopes         String[]  @default([])
  platforms      String[]  @default([])
  state          String    @default("connected")
  metadata       Json?
  connectedAt    DateTime  @default(now()) @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([ownerUserId, provider, accountRef])
  @@index([ownerUserId, state])
  @@map("zcos_social_connections")
}

model SocialCampaign {
  id                   String   @id @default(cuid())
  ownerUserId          String   @map("owner_user_id")
  projectRef           String?  @map("project_ref")
  name                 String
  objective            String
  brandContext         Json     @map("brand_context")
  audienceContext      Json     @map("audience_context")
  platformObjectives   Json     @map("platform_objectives")
  strategyAlternatives Json     @map("strategy_alternatives")
  selectedStrategyId   String?  @map("selected_strategy_id")
  state                String   @default("draft")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, state, updatedAt])
  @@index([ownerUserId, projectRef])
  @@map("zcos_social_campaigns")
}

model SocialResearchSignal {
  id                String    @id @default(cuid())
  ownerUserId       String    @map("owner_user_id")
  campaignId        String    @map("campaign_id")
  contributorGalaxy String    @map("contributor_galaxy")
  platform          String?
  signalType        String    @map("signal_type")
  summary           String
  sourceLocator     String    @map("source_locator")
  sourceTitle       String?   @map("source_title")
  publishedAt       DateTime? @map("published_at")
  accessedAt        DateTime  @map("accessed_at")
  freshUntil        DateTime? @map("fresh_until")
  provenance        Json
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([ownerUserId, campaignId, accessedAt])
  @@index([ownerUserId, platform, freshUntil])
  @@map("zcos_social_research_signals")
}

model SocialContent {
  id              String   @id @default(cuid())
  ownerUserId     String   @map("owner_user_id")
  campaignId      String   @map("campaign_id")
  title           String
  contentKind     String   @map("content_kind")
  brief           Json
  sourceBindings  String[] @default([]) @map("source_bindings")
  assetRefs       String[] @default([]) @map("asset_refs")
  state           String   @default("draft")
  createdByGalaxy String   @default("ZYNC") @map("created_by_galaxy")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, campaignId, state])
  @@map("zcos_social_content")
}

model SocialVariant {
  id               String    @id @default(cuid())
  ownerUserId      String    @map("owner_user_id")
  campaignId       String    @map("campaign_id")
  contentId        String    @map("content_id")
  platform         String
  connectionId     String?   @map("connection_id")
  copy             String
  adaptationNote   String    @map("adaptation_note")
  assetRefs        String[]  @default([]) @map("asset_refs")
  metadata         Json
  state            String    @default("draft")
  scheduledAt      DateTime? @map("scheduled_at")
  approvedAt       DateTime? @map("approved_at")
  approvedBy       String?   @map("approved_by")
  approvalPolicyId String?   @map("approval_policy_id")
  publishedAt      DateTime? @map("published_at")
  providerPostId   String?   @map("provider_post_id")
  providerUrl      String?   @map("provider_url")
  revisionOfId     String?   @map("revision_of_id")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, campaignId, platform, state])
  @@index([ownerUserId, contentId])
  @@index([connectionId, providerPostId])
  @@map("zcos_social_variants")
}

model SocialApprovalPolicy {
  id           String    @id @default(cuid())
  ownerUserId  String    @map("owner_user_id")
  mode         String
  operations   String[]  @default([])
  platform     String?
  campaignId   String?   @map("campaign_id")
  connectionId String?   @map("connection_id")
  startsAt     DateTime  @default(now()) @map("starts_at")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, revokedAt, expiresAt])
  @@index([ownerUserId, campaignId, platform, connectionId])
  @@map("zcos_social_approval_policies")
}

model AutomationJob {
  id             String    @id @default(cuid())
  ownerUserId    String    @map("owner_user_id")
  owningGalaxy   String    @default("ZYLO") @map("owning_galaxy")
  jobType        String    @map("job_type")
  targetType     String    @map("target_type")
  targetId       String    @map("target_id")
  scheduledFor   DateTime  @map("scheduled_for")
  state          String    @default("scheduled")
  idempotencyKey String    @unique @map("idempotency_key")
  attemptCount   Int       @default(0) @map("attempt_count")
  metadata       Json
  cancelledAt    DateTime? @map("cancelled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, owningGalaxy, state, scheduledFor])
  @@index([ownerUserId, targetType, targetId])
  @@map("zcos_automation_jobs")
}

model SocialPublishAttempt {
  id                  String    @id @default(cuid())
  ownerUserId         String    @map("owner_user_id")
  variantId           String    @map("variant_id")
  connectionId        String    @map("connection_id")
  idempotencyKey      String    @unique @map("idempotency_key")
  state               String    @default("running")
  providerOperationId String?   @map("provider_operation_id")
  providerPostId      String?   @map("provider_post_id")
  providerUrl         String?   @map("provider_url")
  providerResult      Json?     @map("provider_result")
  failureCode         String?   @map("failure_code")
  failureMessage      String?   @map("failure_message")
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")

  @@index([ownerUserId, variantId, startedAt])
  @@index([connectionId, providerPostId])
  @@map("zcos_social_publish_attempts")
}

model SocialMetricSnapshot {
  id               String   @id @default(cuid())
  ownerUserId      String   @map("owner_user_id")
  campaignId       String   @map("campaign_id")
  contentId        String?  @map("content_id")
  variantId        String?  @map("variant_id")
  platform         String
  objective        String
  windowStart      DateTime @map("window_start")
  windowEnd        DateTime @map("window_end")
  metrics          Json
  providerSourceId String   @map("provider_source_id")
  sourceBindings   String[] @default([]) @map("source_bindings")
  capturedAt       DateTime @default(now()) @map("captured_at")

  @@index([ownerUserId, campaignId, windowStart, windowEnd])
  @@index([ownerUserId, variantId, platform])
  @@map("zcos_social_metric_snapshots")
}

model SocialOutcomeInsight {
  id              String   @id @default(cuid())
  ownerUserId     String   @map("owner_user_id")
  campaignId      String   @map("campaign_id")
  objective       String
  windowStart     DateTime @map("window_start")
  windowEnd       DateTime @map("window_end")
  snapshotIds     String[] @default([]) @map("snapshot_ids")
  summary         String
  recommendations Json
  state           String   @default("candidate")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, campaignId, state])
  @@map("zcos_social_outcome_insights")
}

model SocialModerationItem {
  id               String   @id @default(cuid())
  ownerUserId      String   @map("owner_user_id")
  campaignId       String?  @map("campaign_id")
  platform         String
  connectionId     String   @map("connection_id")
  providerItemId   String   @map("provider_item_id")
  itemType         String   @map("item_type")
  proposedAction   String   @map("proposed_action")
  riskLevel        String   @map("risk_level")
  state            String   @default("queued")
  providerActionId String?  @map("provider_action_id")
  providerResult   Json?    @map("provider_result")
  failureMessage   String?  @map("failure_message")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, connectionId, providerItemId, itemType])
  @@index([ownerUserId, campaignId, platform, state])
  @@map("zcos_social_moderation_items")
}
